<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kids Craft Maker</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f3f7fb;color:#243047;font-family:Arial,sans-serif}
header{background:#087e8b;color:white;padding:22px 16px;text-align:center}
header h1{margin:0 0 8px;font-size:27px}
header p{margin:0;font-size:14px}
main{max-width:850px;margin:20px auto;padding:0 14px}
.panel{background:white;padding:18px;border-radius:16px;margin-bottom:16px;box-shadow:0 3px 14px #17255410}
h2{font-size:19px;margin:0 0 14px}
label{display:block;font-weight:bold;margin-bottom:8px}
input,select,button{font:inherit}
input,select{width:100%;padding:12px;border:1px solid #cbd5e1;border-radius:9px;background:white}
button{border:0;border-radius:10px;padding:13px 16px;font-weight:bold;cursor:pointer}
.primary{background:#087e8b;color:white;width:100%;margin-top:14px}
.secondary{background:#e0f2fe;color:#075985;width:100%;margin-top:9px}
.note{font-size:13px;color:#64748b;line-height:1.6}
.preview{overflow:auto;background:#e8edf4;padding:12px;border-radius:10px;text-align:center}
#paper{background:white;width:100%;max-width:440px;margin:auto;box-shadow:0 2px 10px #0002}
#paper svg{display:block;width:100%;height:auto}
 @media screen {
  .print-area {
    display: none !important;
  }
 } 
/* Tampilan garis pola prakarya */
#paper svg polygon {
  stroke: #111;
  stroke-width: 0.45;
  stroke-linejoin: round;
}
#paper svg rect {
  stroke: #111;
}

#paper svg line {
  stroke: #555;
}
.status{font-size:14px;line-height:1.6}
footer{text-align:center;color:#64748b;font-size:12px;padding:15px}
@media print{
 @page{size:A4 portrait;margin:0}
 body{background:white}
 
header,.controls,.preview-title,footer,.note-screen,.status{
  display:none!important
}
 main{max-width:none;margin:0;padding:0}
 .panel{padding:0;margin:0;border-radius:0;box-shadow:none}
 .preview{padding:0;margin:0;background:white;overflow:visible}
 #paper{width:210mm;max-width:none;height:297mm;margin:0;box-shadow:none}
 #paper svg{width:210mm;height:297mm}
}
</style>
</head>
<body>
<header>
  <h1>✂️ Kids Craft Maker</h1>
  <p>Rancang pola prakarya, cetak, lipat, dan rakit!</p>
</header>

<main>
  <section class="panel controls">
    <h2>Generator Pola Kubus</h2>
    <label for="side">Panjang sisi kubus (cm)</label>
    <input id="side" type="number" min="2" max="4.2"
      step="0.1" value="3">
    <p class="note">Ukuran sisi 2–4,2 cm. Pola disusun untuk kertas A4 vertikal.</p>

    <label for="tabs">Lebar lidah perekat (mm)</label>
    <input id="tabs" type="number" min="4" max="10"
      step="1" value="6">

    <button class="primary" id="make">Buat Pola Kubus</button>
    <button class="secondary" id="save">Cetak / Simpan PDF</button>
    <p class="note">
      Saat jendela cetak muncul, pilih "Simpan sebagai PDF",
      ukuran kertas A4, skala 100%, dan matikan header serta footer
      browser jika tersedia.
    </p>
  </section>


  <section class="panel print-area">
    <h2 class="preview-title">Pratinjau Pola</h2>
    <div class="preview">
      <div id="paper"></div>
    </div>
    <p class="status" id="status" aria-live="polite">
      Pola siap dibuat.
    </p>
    <p class="note note-screen">
      Garis hitam utuh = potong. Garis putus-putus = lipat.
      Lidah perekat digunakan untuk menyambungkan sisi kubus.
    </p>
  </section>

  <section class="panel controls">
    <h2>Karakter Karton 3D</h2>
    <label for="character">Pilih karakter</label>
    <select id="character">
      <option value="rabbit">Kelinci</option>
      <option value="cat">Kucing</option>
      <option value="robot">Robot</option>
    </select>
    <p class="note">
      Pilih karakter untuk membuat pola prakarya 3D.
    </p>
    <button class="primary" id="characterButton" type="button">
      Buat Pola Karakter
    </button>
  </section>
</main>


<footer>Kids Craft Maker · Pola prakarya anak</footer>

<script>
const NS = "http://www.w3.org/2000/svg";
const paper = document.getElementById("paper");
const statusText = document.getElementById("status");

function svgEl(tag, attrs = {}) {
  const el = document.createElementNS(NS, tag);
  for (const [key, value] of Object.entries(attrs)) {
    el.setAttribute(key, value);
  }
  return el;
}

function createPattern() {
  const sideCm = Number(document.getElementById("side").value);
  const tabMm = Number(document.getElementById("tabs").value);

  if (!Number.isFinite(sideCm) || sideCm < 2 || sideCm > 4.2) {
    alert("Masukkan panjang sisi antara 2 dan 4,2 cm.");
    return false;
  }

  if (!Number.isFinite(tabMm) || tabMm < 4 || tabMm > 10) {
    alert("Masukkan lebar perekat antara 4 dan 10 mm.");
    return false;
  }

  const s = sideCm * 10;
  const t = tabMm;

  // Empat bidang berjajar, satu di atas dan satu di bawah.
  const faces = [
    [0, 1], [1, 1], [2, 1], [3, 1],
    [1, 0], [1, 2]
  ];
  const occupied = new Set(faces.map(([x,y]) => `${x},${y}`));

  // Ukuran halaman fisik A4 dalam milimeter.
  const pageW = 210, pageH = 297;
  const netW = 4 * s;
  const netH = 3 * s;
  const offsetX = (pageW - netW) / 2;
  const offsetY = (pageH - netH) / 2;

  const svg = svgEl("svg", {
    xmlns: NS,
    viewBox: `0 0 ${pageW} ${pageH}`,
    width: `${pageW}mm`,
    height: `${pageH}mm`,
    role: "img",
    "aria-label": "Pola kubus untuk dicetak"
  });

  svg.appendChild(svgEl("rect", {
    x: 0, y: 0, width: pageW, height: pageH, fill: "white"
  }));

  const title = svgEl("text", {
    x: pageW/2, y: 24, "text-anchor": "middle",
    "font-size": 5, "font-family": "Arial", "font-weight": "bold",
    fill: "#111"
  });
  title.textContent = "POLA KUBUS";
  svg.appendChild(title);
 
const instruction = svgEl("text", {
  x: pageW / 2,
  y: 49,
  "text-anchor": "middle",
  "font-size": 3,
  "font-family": "Arial",
  fill: "#333"
});
instruction.textContent =
  "Garis utuh: potong | Garis putus-putus: lipat";
svg.appendChild(instruction);

const instruction2 = svgEl("text", {
  x: pageW / 2,
  y: 54,
  "text-anchor": "middle",
  "font-size": 3,
  "font-family": "Arial",
  fill: "#333"
});
instruction2.textContent =
  "Oleskan lem pada lidah perekat, lalu satukan sisi kubus.";
svg.appendChild(instruction2);

  const subtitle = svgEl("text", {
    x: pageW/2, y: 31, "text-anchor": "middle",
    "font-size": 3.4, "font-family": "Arial", fill: "#333"
  });
  subtitle.textContent = `Panjang setiap sisi: ${sideCm} cm`;
  svg.appendChild(subtitle);

  const group = svgEl("g", {
    transform: `translate(${offsetX},${offsetY})`
  });
  svg.appendChild(group);

  // Gambar bidang dan garis lipatnya.
  for (const [x,y] of faces) {
    group.appendChild(svgEl("rect", {
      x: x*s, y: y*s, width: s, height: s,
      fill: "white", stroke: "#111", "stroke-width": 0.35
    }));
  }

  // Lidah perekat hanya ditempatkan di sisi luar pola.
  // Sudut dipotong miring agar tab tidak bertumpuk.
  const edges = [
    {dx:0,dy:-1, edge:"top"},
    {dx:1,dy:0, edge:"right"},
    {dx:0,dy:1, edge:"bottom"},
    {dx:-1,dy:0, edge:"left"}
  ];

  for (const [x,y] of faces) {
    for (const e of edges) {
      if (occupied.has(`${x+e.dx},${y+e.dy}`)) continue;

      let points;
      const inset = Math.min(3, s*0.15);
      const depth = Math.min(t, s*0.25);

      if (e.edge === "top") {
        points = [
          [x*s+inset,y*s],
          [x*s+s-inset,y*s],
          [x*s+s-inset-depth,y*s-depth],
          [x*s+inset+depth,y*s-depth]
        ];
      } else if (e.edge === "bottom") {
        points = [
          [x*s+inset,(y+1)*s],
          [x*s+s-inset,(y+1)*s],
          [x*s+s-inset-depth,(y+1)*s+depth],
          [x*s+inset+depth,(y+1)*s+depth]
        ];
      } else if (e.edge === "left") {
        points = [
          [x*s,y*s+inset],
          [x*s,(y+1)*s-inset],
          [x*s-depth,(y+1)*s-inset-depth],
          [x*s-depth,y*s+inset+depth]
        ];
      } else {
        points = [
          [(x+1)*s,y*s+inset],
          [(x+1)*s,(y+1)*s-inset],
          [(x+1)*s+depth,(y+1)*s-inset-depth],
          [(x+1)*s+depth,y*s+inset+depth]
        ];
      }

      group.appendChild(svgEl("polygon", {
        points: points.map(p => p.join(",")).join(" "),
        fill: "white", stroke: "#111", "stroke-width": 0.35
      }));

      // Garis lipat pada pangkal lidah perekat.
      let x1,y1,x2,y2;
      if (e.edge === "top") {
        x1=x*s+inset; x2=(x+1)*s-inset; y1=y2=y*s;
      } else if (e.edge === "bottom") {
        x1=x*s+inset; x2=(x+1)*s-inset; y1=y2=(y+1)*s;
      } else if (e.edge === "left") {
        x1=x2=x*s; y1=y*s+inset; y2=(y+1)*s-inset;
      } else {
        x1=x2=(x+1)*s; y1=y*s+inset; y2=(y+1)*s-inset;
      }

      group.appendChild(svgEl("line", {
        x1,y1,x2,y2, stroke:"#555",
        "stroke-width":0.3, "stroke-dasharray":"1.5 1"
      }));
    }
  }

  // Garis lipat antarbidang.
  for (const [x,y] of faces) {
    for (const e of [{dx:1,dy:0},{dx:0,dy:1}]) {
      if (!occupied.has(`${x+e.dx},${y+e.dy}`)) continue;

      let x1,y1,x2,y2;
      if (e.dx === 1) {
        x1=x2=(x+1)*s; y1=y*s; y2=(y+1)*s;
      } else {
        x1=x*s; x2=(x+1)*s; y1=y2=(y+1)*s;
      }

      
group.appendChild(svgEl("line", {
  x1, y1, x2, y2,
  stroke: "#555",
  "stroke-width": 0.5,
  "stroke-dasharray": "2 1.5",
  "stroke-linecap": "butt"
}));

    }
  }

  paper.replaceChildren(svg);
  statusText.textContent =
    `Pola berhasil dibuat. Sisi ${sideCm} cm, perekat ${tabMm} mm, kertas A4.`;
  return true;
}

document.getElementById("make").addEventListener("click", createPattern);

document.getElementById("save").addEventListener("click", () => {
  if (createPattern()) window.print();
});

createPattern();
 
document.getElementById("characterButton").addEventListener("click", () => {
  const character = document.getElementById("character").value;
  alert(
    "Karakter " + character +
    " dipilih. Generator pola karakter akan dibuat pada tahap berikutnya."
  );
});

</script>
</body>
</html>
